{
  "name": "moyu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Moyu local-first AI agent platform",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "test": "node --import tsx --test src/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "workbench:export-data": "tsx src/cli.ts ui export-data",
    "workbench:serve": "tsx src/cli.ts ui serve",
    "prototype:export-data": "tsx src/cli.ts ui export-data",
    "prototype:workbench": "tsx src/cli.ts ui serve"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.20.4",
    "typescript": "^5.8.3"
  }
}
