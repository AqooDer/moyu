# aiartmirror / OpenAI-compatible image relay.
# You can set either the root URL or the full generations endpoint:
#   https://www.aiartmirror.com
#   https://www.aiartmirror.com/v1
#   https://www.aiartmirror.com/v1/images/generations
MOYU_IMAGE_PROVIDER_BASE_URL=https://www.aiartmirror.com
MOYU_IMAGE_PROVIDER_API_KEY=replace_me
MOYU_IMAGE_PROVIDER_MODEL=gpt-image-2
MOYU_IMAGE_RESPONSE_FORMAT=b64_json
