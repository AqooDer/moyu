# aiartmirror / OpenAI-compatible image relay.
# You can set either the root URL or the full generations endpoint:
#   https://www.aiartmirror.com
#   https://www.aiartmirror.com/v1
#   https://www.aiartmirror.com/v1/images/generations
MOYU_IMAGE_PROVIDER_BASE_URL=https://www.aiartmirror.com
MOYU_IMAGE_PROVIDER_API_KEY=your_api_key_here
MOYU_IMAGE_PROVIDER_MODEL=gpt-image-2
# Only sent for DALL-E 2/3. GPT image models return b64_json by default.
MOYU_IMAGE_RESPONSE_FORMAT=b64_json

# OpenAI-compatible chat completion provider for Meta-Agent authoring.
# You can set either the provider root URL, /v1 URL, or full /v1/chat/completions endpoint.
MOYU_LLM_PROVIDER_BASE_URL=https://api.openai.com
MOYU_LLM_PROVIDER_API_KEY=your_api_key_here
MOYU_LLM_PROVIDER_MODEL=gpt-4.1-mini
