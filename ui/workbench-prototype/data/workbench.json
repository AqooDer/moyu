          "label": {
            "zh": "运行时收集",
            "en": "Runtime collection"
          },
          "value": {
            "zh": "记录模型角色、路由命中、知识库来源",
            "en": "Capture model roles, routing hits, and KB sources"
          },
          "note": {
            "zh": "为后续优化默认值与回归定位提供证据",
            "en": "Feed later default tuning and regressions with evidence"
