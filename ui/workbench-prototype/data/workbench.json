      "highlights": [
        {
          "label": {
            "zh": "默认策略",
            "en": "Default mode"
          },
          "value": {
            "zh": "先继承 Workspace，再按 Agent 覆盖",
            "en": "Inherit workspace, then override per agent"
          },
          "note": {
            "zh": "避免把具体模型名写死进 Agent",
            "en": "Avoid hard-coding model ids into agents"
